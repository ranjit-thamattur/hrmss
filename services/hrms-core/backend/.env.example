# Copy to services/hrms-core/backend/.env to run the API natively (without Docker). Docker Compose sets these itself.
# LAPTOP ONLY: synthetic data. Real client data lives only in QA/production.
ENVIRONMENT=local

# The client this run serves: its YAML file and the folder that holds its backend package.
CLIENT_CONFIG=../../hotel_vivek_backend/client.yaml
CLIENT_PACKAGE_PATH=../../hotel_vivek_backend

# Empty DATABASE_URL = SQLite file named after the client database (hrms_hv.db)
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://hrms:hrms@localhost:5432/hrms_hv
AUTH_MODE=local
JWT_SECRET=change-me-local-only
# FIELD_ENCRYPTION_KEY=   (required outside local; generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
SEED_DEMO=true
DEMO_PASSWORD=Peak@12345
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
