# Copy to services/hrms-core/backend/.env for running natively (without Docker). Docker Compose sets these itself.
# LAPTOP ONLY: synthetic data. Real client data lives only in QA/production (decision 0006).
ENVIRONMENT=local

# Client (tenant): Hotel Vivek
TENANT=HV
TENANT_PACKAGE=hotel_vivek
TENANT_PATH=../../hotel_vivek_backend

# Empty DATABASE_URL = SQLite file hrms_hv.db (one database per client)
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://hrms:hrms@localhost:5432/hrms_hv
AUTH_MODE=local
JWT_SECRET=change-me-local-only
# FIELD_ENCRYPTION_KEY=   (required outside local; generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
BIOMETRIC_ADAPTER=excel
SEED_DEMO=true
DEMO_PASSWORD=Peak@12345
DEMO_EMPLOYEE_COUNT=256
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Monitoring (SCRUM-130). MONITOR_WEB_URL empty = web app shown as "not checked" when running natively.
MONITOR_INTERVAL_SECONDS=60
MONITOR_WEB_URL=
MONITOR_ALERT_EMAILS=
