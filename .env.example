# Optional settings for docker compose (copy to .env in this folder and change what you need).
# Without a .env file the defaults below are used. LAPTOP ONLY - never put real client data or real secrets here.

# Ports on your machine (change one if "port is already allocated")
API_PORT=8000
DB_PORT=5432
COGNITO_PORT=9229
ADMINER_PORT=8081

# Sign-in: cognito = local Cognito container (same flow as AWS); local = passwords checked by the API itself
AUTH_MODE=cognito

# Demo data (synthetic Hotel Vivek): loaded on first start of an empty database
SEED_DEMO=true
DEMO_PASSWORD=Peak@12345

# Laptop-only secrets (any text works locally)
JWT_SECRET=change-me-local-only
FIELD_ENCRYPTION_KEY=

# Front-end dev servers allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
