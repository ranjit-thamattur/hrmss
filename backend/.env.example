# Copy to backend/.env for running natively (without Docker). Docker Compose sets these itself.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./hrms.db
# DATABASE_URL=postgresql+psycopg://hrms:hrms@localhost:5432/hrms
AUTH_MODE=local
JWT_SECRET=change-me-local-only
# FIELD_ENCRYPTION_KEY=   (required outside local; generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
BIOMETRIC_ADAPTER=excel
SEED_DEMO=true
DEMO_PASSWORD=Peak@12345
DEMO_EMPLOYEE_COUNT=256
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
